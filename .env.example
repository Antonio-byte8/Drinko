# ── Drinko local config ──────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Never commit .env to git.

# Supabase (Settings → API in your Supabase project)
SUPABASE_URL=https://YOURPROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Stripe (Developers → API keys in your Stripe dashboard)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Your deployed site URL (used in Stripe redirect links and invite emails)
# For local dev: http://localhost:3000
SITE_URL=http://localhost:3000

# Default venue slug shown when no ?club= is in the URL
DEFAULT_CLUB=aurora

# Admin key — a secret string you invent (protects admin.html)
ADMIN_KEY=change-this-to-something-secret
